<mxfile host="app.diagrams.net" agent="dgm.py" version="24.0.0">
<diagram id="axi4-lite-to-apb3-bridge---architecture" name="AXI4-Lite to APB3 bridge - architecture">
<mxGraphModel dx="1320" dy="640" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="640" math="0" shadow="0"><root>
<mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="g" value="axi2apb  (DATA_WIDTH = ADDR_WIDTH = 32, one clock, synchronous active-low reset)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#888888;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=8;spacingTop=4;spacingBottom=4;fontStyle=1;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="235" y="60" width="835" height="470" as="geometry"/></mxCell>
<mxCell id="m" value="&lt;b&gt;AXI4-Lite master&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;AR: ARADDR ARVALID ARREADY&lt;br&gt;R : RDATA RRESP RVALID RREADY&lt;br&gt;AW: AWADDR AWVALID AWREADY&lt;br&gt;W : WDATA WVALID WREADY&lt;br&gt;B : BRESP BVALID BREADY&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="130" width="190" height="330" as="geometry"/></mxCell>
<mxCell id="fsm" value="&lt;b&gt;Control FSM  (present_state / next_state)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;IDLE, WRITE_ADDRESS_RECEIVED, WRITE_DATA_RECEIVED, PENABLE_WRITE,&lt;br&gt;WDATA_TRANSFERRED, READ_ADDRESS_RECEIVED, PENABLE_READ,&lt;br&gt;RDATA_TRANSFERRED   -   a read request wins in IDLE&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="290" y="100" width="400" height="115" as="geometry"/></mxCell>
<mxCell id="dec" value="&lt;b&gt;Output decode&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;ARREADY AWREADY WREADY RVALID BVALID&lt;br&gt;PSEL PENABLE PWRITE&lt;br&gt;(each a function of present_state)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="740" y="100" width="300" height="115" as="geometry"/></mxCell>
<mxCell id="sa" value="&lt;b&gt;sampled_addr&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;ARADDR or AWADDR,&lt;br&gt;latched in IDLE&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="290" y="270" width="170" height="75" as="geometry"/></mxCell>
<mxCell id="pa" value="&lt;b&gt;PADDR / PWDATA regs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;loaded when W is accepted&lt;br&gt;or a read starts&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="510" y="270" width="180" height="75" as="geometry"/></mxCell>
<mxCell id="rr" value="&lt;b&gt;Response registers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;RDATA &amp;lt;= PRDATA (if !PSLVERR);  BRESP, RRESP &amp;lt;= PSLVERR ? SLVERR (2&amp;#x27;b10) : OKAY&lt;br&gt;(the as-found RTL returned DECERR, 2&amp;#x27;b11: change CH-001)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="290" y="390" width="400" height="85" as="geometry"/></mxCell>
<mxCell id="ap" value="&lt;b&gt;APB3 slave&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;PADDR PSEL PENABLE&lt;br&gt;PWRITE PWDATA&lt;br&gt;PREADY PRDATA PSLVERR&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="1100" y="130" width="190" height="330" as="geometry"/></mxCell>
<mxCell id="n" value="One transaction at a time: a read or write is accepted in IDLE, one APB transfer is performed (setup phase, then access phase until PREADY), and the response is held until the master takes it.&lt;br&gt;AWREADY and WREADY are asserted together and only in WRITE_ADDRESS_RECEIVED, so write data that arrives before its address waits. A read request has priority over a simultaneous write request." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#222222;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="560" width="1190.72" height="33.5" as="geometry"/></mxCell>
<mxCell id="h" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#c55a11;strokeWidth=1.8;rounded=0;dashed=1;dashPattern=6 4;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m" target="fsm" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
