<diagram id="axi4-lite-to-apb3-bridge---fsm-and-transfer-flowchart" name="AXI4-Lite to APB3 bridge - FSM and transfer flowchart">
<mxGraphModel dx="1250" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="1000" math="0" shadow="0"><root>
<mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="idle" value="&lt;b&gt;IDLE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;all VALID/READY outputs low; sample the address&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="480" y="55" width="280" height="55" as="geometry"/></mxCell>
<mxCell id="dar" value="&lt;b&gt;ARVALID ?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;read has priority&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="480" y="140" width="280" height="78" as="geometry"/></mxCell>
<mxCell id="daw" value="&lt;b&gt;AWVALID ?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="480" y="245" width="280" height="78" as="geometry"/></mxCell>
<mxCell id="wa" value="&lt;b&gt;WRITE_ADDRESS_RECEIVED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;AWREADY = WREADY = 1&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="300" height="64" as="geometry"/></mxCell>
<mxCell id="dw" value="&lt;b&gt;WVALID ?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="300" height="72" as="geometry"/></mxCell>
<mxCell id="wd" value="&lt;b&gt;WRITE_DATA_RECEIVED  (APB setup)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;PSEL = 1, PWRITE = 1&lt;br&gt;PADDR, PWDATA loaded&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="300" height="64" as="geometry"/></mxCell>
<mxCell id="pw" value="&lt;b&gt;PENABLE_WRITE  (APB access)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;PSEL = PENABLE = PWRITE = 1&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="612" width="300" height="64" as="geometry"/></mxCell>
<mxCell id="dpw" value="&lt;b&gt;PREADY ?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;no: stay (wait state)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="704" width="300" height="72" as="geometry"/></mxCell>
<mxCell id="wt" value="&lt;b&gt;WDATA_TRANSFERRED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;BRESP &amp;lt;= PSLVERR ? SLVERR : OKAY&lt;br&gt;BVALID = 1&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="300" height="64" as="geometry"/></mxCell>
<mxCell id="db" value="&lt;b&gt;BREADY ?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;no: hold BVALID, BRESP&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="892" width="300" height="72" as="geometry"/></mxCell>
<mxCell id="ra" value="&lt;b&gt;READ_ADDRESS_RECEIVED  (APB setup)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;ARREADY = 1, PSEL = 1&lt;br&gt;PADDR &amp;lt;= ARADDR&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="900" y="330" width="300" height="64" as="geometry"/></mxCell>
<mxCell id="pr" value="&lt;b&gt;PENABLE_READ  (APB access)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;PSEL = PENABLE = 1, PWRITE = 0&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="900" y="430" width="300" height="64" as="geometry"/></mxCell>
<mxCell id="dpr" value="&lt;b&gt;PREADY ?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;no: stay (wait state)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="900" y="522" width="300" height="72" as="geometry"/></mxCell>
<mxCell id="rt" value="&lt;b&gt;RDATA_TRANSFERRED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;RDATA &amp;lt;= PRDATA (if !PSLVERR)&lt;br&gt;RRESP &amp;lt;= PSLVERR ? SLVERR : OKAY, RVALID = 1&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="900" y="620" width="300" height="64" as="geometry"/></mxCell>
<mxCell id="dr" value="&lt;b&gt;RREADY ?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;no: hold RVALID, RDATA, RRESP&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="900" y="712" width="300" height="72" as="geometry"/></mxCell>
<mxCell id="fin" value="&lt;b&gt;Back to IDLE&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="480" y="912" width="280" height="55" as="geometry"/></mxCell>
<mxCell id="n" value="One APB transfer = a setup phase&lt;br&gt;(PSEL, no PENABLE) followed by an access&lt;br&gt;phase (PSEL and PENABLE) that lasts&lt;br&gt;until PREADY.&lt;br&gt;&lt;br&gt;A response is held until the AXI master&lt;br&gt;asserts BREADY / RREADY; one transaction&lt;br&gt;is outstanding at a time." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#222222;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="360" y="440" width="254.4" height="116" as="geometry"/></mxCell>
